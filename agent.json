{
  "name": "hinh-bang-code",
  "version": "2.0.0",
  "summary": "Sinh ảnh mạng xã hội bằng code: SVG thuần → PNG. Không cần API key để tạo ảnh cục bộ; dùng GitHub Actions để render và lưu ảnh công khai.",
  "locale": "vi",
  "site": "https://vanthuonghi.github.io/hinh-bang-code",
  "repo": "vanthuonghi/hinh-bang-code",
  "branch": "main",
  "docs": {
    "agent_page": "https://vanthuonghi.github.io/hinh-bang-code/agent.html",
    "llms_txt": "https://vanthuonghi.github.io/hinh-bang-code/llms.txt",
    "this_file": "https://vanthuonghi.github.io/hinh-bang-code/agent.json",
    "readme": "https://github.com/vanthuonghi/hinh-bang-code#readme",
    "source_lib": "https://github.com/vanthuonghi/hinh-bang-code/blob/main/lib/svg.js"
  },
  "entrypoints": {
    "local_js": {
      "install": "Không cần cài — import trực tiếp file trong repo (ESM, không dependency).",
      "import": "import { buildSVG, normalize, validateRequest } from './lib/svg.js'",
      "output": "buildSVG(req) trả về chuỗi SVG (string). Thêm sharp để ra PNG."
    },
    "cli": {
      "command": "node bin/hinh.mjs",
      "requires": "Node >= 20, GITHUB_TOKEN (scope repo + workflow) hoặc `gh auth login`",
      "commands": {
        "new": "node bin/hinh.mjs new --title \"Tiêu đề\" --theme aurora --layout hero --size 1200x630 --wait --out ./anh",
        "preset": "node bin/hinh.mjs new --preset lo-trinh --title \"Lộ trình 3 bước\" --wait",
        "catalog": "node bin/hinh.mjs catalog --json",
        "list": "node bin/hinh.mjs list --n 10 --json",
        "get": "node bin/hinh.mjs get <ten-file.png> --out ./anh",
        "status": "node bin/hinh.mjs status --json"
      }
    },
    "github_actions": {
      "dispatch": {
        "method": "POST",
        "url": "https://api.github.com/repos/vanthuonghi/hinh-bang-code/actions/workflows/render.yml/dispatches",
        "headers": {
          "Authorization": "Bearer $GITHUB_TOKEN",
          "Accept": "application/vnd.github+json"
        },
        "body": {
          "ref": "refs/heads/main",
          "inputs": {
            "title": "Tiêu đề",
            "theme": "aurora",
            "layout": "hero",
            "size": "1200x630"
          }
        },
        "notes": [
          "Thiếu \"ref\" sẽ trả 422.",
          "Run được xếp hàng tuần tự (concurrency), không chạy song song."
        ]
      },
      "issue": {
        "url": "https://github.com/vanthuonghi/hinh-bang-code/issues/new",
        "rule": "Tiêu đề issue bắt đầu bằng \"[render]\". Thân issue dạng \"Khoá: giá trị\", mỗi dòng một khoá.",
        "result_comment": "Mỗi issue được trả về một comment kèm ảnh và một khối ```json {ok,file,svg,png_url,svg_url,title,theme,layout,size,pattern,issue,run_id,run_url} — agent parse khối đó thay vì bóc chữ.",
        "body_example": "[render] 3 việc nên tự động hoá ngay\n\nTiêu đề: 3 việc nên tự động hoá ngay\nPhụ đề: Việc lặp lại;Việc dễ sai;Báo cáo định kỳ\nTác giả: VANHI\nKích thước: 1200x628\nTheme: steel\nBố cục: list\nHoa tiết: grid"
      },
      "read_result": {
        "manifest": "https://raw.githubusercontent.com/vanthuonghi/hinh-bang-code/main/gallery/manifest.json",
        "png": "https://github.com/vanthuonghi/hinh-bang-code/raw/main/gallery/{file}",
        "svg": "https://github.com/vanthuonghi/hinh-bang-code/raw/main/gallery/{svg}",
        "manifest_contents_api": "https://api.github.com/repos/vanthuonghi/hinh-bang-code/contents/gallery/manifest.json?ref=main",
        "manifest_cache_note": "raw.githubusercontent.com bị CDN cache tới ~5 phút; Contents API luôn trả bản mới nhất.",
        "runs": "https://api.github.com/repos/vanthuonghi/hinh-bang-code/actions/workflows/render.yml/runs?event=workflow_dispatch&per_page=20",
        "manifest_fields": [
          "file",
          "svg",
          "title",
          "theme",
          "layout",
          "size",
          "pattern",
          "issue",
          "user",
          "date"
        ]
      }
    },
    "browser": {
      "url": "https://vanthuonghi.github.io/hinh-bang-code",
      "notes": "Tải PNG/SVG ngay trong trình duyệt, không cần đăng nhập. Trang giữ yêu cầu trong URL (?t=…&th=…&l=…&sz=…&p=…) để chia sẻ."
    }
  },
  "inputs": [
    {
      "key": "title",
      "label": "Tiêu đề",
      "type": "string",
      "required": true,
      "max": 120,
      "description": "Nội dung chính của ảnh. Chữ tự xuống dòng và tự thu nhỏ để vừa khung.",
      "example": "3 việc nên tự động hoá ngay"
    },
    {
      "key": "subtitle",
      "label": "Phụ đề",
      "type": "string",
      "required": false,
      "max": 160,
      "description": "Một câu bổ trợ. Với layout list/timeline, mỗi mục cách nhau bằng dấu \";\" hoặc \"|\".",
      "example": "Việc lặp lại;Việc dễ sai;Báo cáo định kỳ"
    },
    {
      "key": "author",
      "label": "Tác giả / nhãn",
      "type": "string",
      "required": false,
      "max": 40,
      "description": "Dòng nhỏ trên cùng; thành avatar/nhãn xoay với layout story/sticker/quote.",
      "example": "VANHI"
    },
    {
      "key": "theme",
      "label": "Bảng màu",
      "type": "enum",
      "required": false,
      "default": "sunset",
      "description": "Khoá trong catalog.themes. Giá trị lạ tự fallback về sunset.",
      "example": "aurora"
    },
    {
      "key": "layout",
      "label": "Bố cục",
      "type": "enum",
      "required": false,
      "default": "left",
      "description": "Khoá trong catalog.layouts. Giá trị lạ tự fallback về left.",
      "example": "list"
    },
    {
      "key": "size",
      "label": "Kích thước",
      "type": "enum",
      "required": false,
      "default": "1200x630",
      "description": "Khoá dạng \"RxC\" trong catalog.sizes. Giá trị lạ tự fallback về 1200x630.",
      "example": "1080x1350"
    },
    {
      "key": "pattern",
      "label": "Hoa tiết nền",
      "type": "enum",
      "required": false,
      "default": "orb",
      "description": "Khoá trong catalog.patterns. Giá trị lạ tự fallback về orb.",
      "example": "grid"
    },
    {
      "key": "emoji",
      "label": "Emoji",
      "type": "string",
      "required": false,
      "max": 8,
      "description": "Một emoji, hiện lớn phía trên tiêu đề (trừ quote/sticker/terminal/story).",
      "example": "🚀"
    },
    {
      "key": "footer",
      "label": "Chú thích",
      "type": "string",
      "required": false,
      "max": 80,
      "description": "Dòng chữ nhỏ góc dưới trái. Để trống thì ảnh KHÔNG có dòng nào ở đáy.",
      "example": "vanthuonghi.com"
    }
  ],
  "fallbacks": {
    "note": "Mọi input đều được chuẩn hoá: giá trị lạ/thiếu không gây lỗi, chỉ về mặc định.",
    "theme": "sunset",
    "layout": "left",
    "size": "1200x630",
    "pattern": "orb",
    "title": "Yêu cầu hình",
    "max_lengths": {
      "title": 120,
      "subtitle": 160,
      "author": 40,
      "footer": 80
    }
  },
